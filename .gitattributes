# Auto-detect text files and normalize line endings
* text=auto eol=lf

# PHP files
*.php text eol=lf

# Web files
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf

# Data/config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary

# Export-ignore (excluded from git archive / production ZIP)
.github/ export-ignore
.claude/ export-ignore
.idea/ export-ignore
.vscode/ export-ignore
.playwright-mcp/ export-ignore
tests/ export-ignore
docs/ export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.phpcs.xml export-ignore
phpstan.neon export-ignore
phpunit.xml export-ignore
composer.lock export-ignore
CLAUDE.md export-ignore
*.log export-ignore
*.cache export-ignore
